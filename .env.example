# AI-Powered Medical Diagnosis System

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE (MongoDB)
# ============================================
# Leave blank for the MongoDB service in Docker Compose. For local Node runs,
# set mongodb://127.0.0.1:27017/mediscan_ai or a private Atlas connection string.
MONGODB_URI=
MONGODB_DB_NAME=mediscan_ai
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# AES-256 ENCRYPTION
# ============================================
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here_64_chars
ENCRYPTION_IV_LENGTH=16

# ============================================
# AI ENGINE
# ============================================
AI_ENGINE_URL=http://localhost:5000
AI_ENGINE_API_KEY=replace_with_a_random_shared_secret
AI_API_KEY=replace_with_the_same_random_shared_secret

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# FLASK AI ENGINE
# ============================================
FLASK_ENV=development
FLASK_PORT=5000
MODEL_PATH=./saved_models

# Next.js same-origin API proxy target (server-only)
API_ORIGIN=http://localhost:3001
